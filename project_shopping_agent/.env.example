# Copy this file to .env and add your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Chat and the off-topic check
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none

# If Qwen's free daily allowance runs out, use these two lines instead:
#   GROQ_MODEL=openai/gpt-oss-20b
#   GROQ_REASONING_EFFORT=low

# Photos (Qwen is the Groq model here that can read images)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_REASONING_EFFORT=none
