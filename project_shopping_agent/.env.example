# Copy this file to .env and paste your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Demo / PRD setup: Qwen for everything
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=none

# Testing setup (saves Qwen's free daily quota): replace the two lines above with
#   GROQ_MODEL=openai/gpt-oss-120b
#   GROQ_REASONING_EFFORT=low
# Photos always use Qwen (the only Groq model here that reads images):
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_REASONING_EFFORT=none
