# Copy to .env (local) or add as Vercel environment variables. Never commit real keys.
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key          # backup model, optional

# Optional protection of the review endpoint
ACCESS_CODE=                        # if set, every review call must send this code (the app asks once per session)
RATE_LIMIT_PER_5MIN=90              # requests per IP per 5 minutes (best effort, per server instance)
DAILY_MODEL_CALLS=2500              # stop calling models after this many calls per day per instance
